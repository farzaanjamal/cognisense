    "SPB": {
      "kind": "spatial_span",
      "version": "0.2",
      "pads": "BOARD",
      "direction": "backward",
      "board": "span_board",
      "fixation_before_ms": 1000,
      "highlight_ms": 700,
      "inter_highlight_ms": 300,
      "cue_delay_ms": 500,
      "echo_ms": 200,
      "recall_timeout_ms": 30000,
      "iti_ms": 1000,
      "start_length": 2,
      "max_length": 8,
      "trials_per_length": 2,
      "practice": {
        "sequences": [[0, 1], [8, 2]],
        "min_correct": 1
      },
      "sequence_generation": "SpanSequences.generate(seed=20261002, label=\"SPB\", perLength=2, squares=9); practice: SpanSequences.generatePractice(seed=20261002, label=\"SPB:practice\", excluding all scored sequences). CoreTests checks this file still matches.",
      "sequences": {
        "2": [[8, 4], [7, 4]],
        "3": [[2, 4, 7], [8, 1, 7]],
        "4": [[3, 4, 0, 7], [8, 5, 7, 6]],
        "5": [[3, 8, 7, 4, 5], [4, 6, 8, 7, 2]],
        "6": [[3, 8, 0, 4, 6, 7], [8, 5, 3, 1, 2, 0]],
        "7": [[3, 2, 6, 7, 8, 4, 5], [0, 4, 2, 8, 3, 1, 7]],
        "8": [[1, 3, 4, 7, 0, 5, 6, 8], [3, 1, 8, 2, 7, 5, 0, 4]]
