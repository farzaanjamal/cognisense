      "review": {
        "max_length": 4
      },
      "retest": {
        "sequence_generation": "SpanSequences.generateMatched(seed=20261002, label=\"SPB:retest\", reference=this part's sequences, positions in dp, tolerance=0.10, excluding all standard and practice sequences): path length on the board within 10% of the matching standard sequence. CoreTests checks this file still matches.",
        "sequences": {
          "2": [[1, 0], [4, 7]],
