    "TRP": {
      "kind": "time_reproduction",
      "version": "0.1",
      "pads": "SINGLE",
      "stimulus": "trp_circle",
      "durations_ms": [1000, 2000, 4000, 6000],
      "repetitions": 4,
      "max_consecutive_same": 2,
      "fixation_before_ms": 1000,
      "pause_before_response_ms": 500,
      "press_timeout_ms": 10000,
      "max_hold_ms": 20000,
      "premature_release_ms": 200,
      "iti_ms": 1000,
      "practice": {
